// Cloudflare Worker for Piron Talent, built by OpenNext from the main branch: npm run deploy.
// Secrets and variables are typed into the Cloudflare dashboard by the owner, never written here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "piron-talent",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "piron-talent" }],
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  // Public hostname of the app. piron.tech itself is the company website, hosted elsewhere.
  "routes": [
    { "pattern": "app.piron.tech", "custom_domain": true }
  ],
  // Public, non-secret runtime variables. Secrets stay in the dashboard.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://app.piron.tech",
    // Public half of the Web Push key pair; the private half and PUSH_HOOK_SECRET are dashboard secrets.
    "NEXT_PUBLIC_VAPID_PUBLIC_KEY": "BKTEsVtsDH4QQGLAV4U0zGlmvMwrUig3LrHHBa_fszQxs1IyFJwzagjIpm2ECBZFFWSDQqQBRhXCsI1XdQWCaEU"
  }
}
